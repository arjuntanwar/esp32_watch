String readChapterName(int ch) {
  File f = SD.open("/index.txt");
  String line = "";
  for(int i = 1; i <= ch; i++) {
    if(f.available()) line = f.readStringUntil('\n');
  }
  f.close();
  line.trim();
  if(line == "") line = "Chapter " + String(ch);
  return line;
}

String readTopicName(int ch, int topic) {
  String path = "/ch" + String(ch) + "/index.txt";
  File f = SD.open(path);
  String line = "";
  for(int i = 1; i <= topic; i++) {
    if(f.available()) line = f.readStringUntil('\n');
  }
  f.close();
  line.trim();
  if(line == "") line = "Topic " + String(topic);
  return line;
}

String readTopicContent(int ch, int topic) {
  String path = "/ch" + String(ch) + "/topic" + String(topic) + ".txt";
  File f = SD.open(path);
  String content = "";
  while(f.available()) content += (char)f.read();
  f.close();
  if(content == "") content = "No content yet.";
  return content;
}

bool saveTopicContent(int ch, int topic, String content) {
  String path = "/ch" + String(ch) + "/topic" + String(topic) + ".txt";
  if(SD.exists(path)) SD.remove(path);
  File f = SD.open(path, FILE_WRITE);
  if(!f) return false;
  f.print(content);
  f.close();
  return true;
}

bool renameChapter(int ch, String newName) {
  String allChapters[MAX_CHAPTERS];
  File f = SD.open("/index.txt");
  for(int i = 0; i < MAX_CHAPTERS; i++) {
    if(f.available()) allChapters[i] = f.readStringUntil('\n');
    else allChapters[i] = "Chapter " + String(i+1);
    allChapters[i].trim();
  }
  f.close();
  
  allChapters[ch-1] = newName;
  
  SD.remove("/index.txt");
  File wf = SD.open("/index.txt", FILE_WRITE);
  for(int i = 0; i < MAX_CHAPTERS; i++) {
    wf.println(allChapters[i]);
  }
  wf.close();
  
  loadChapters();
  return true;
}

bool renameTopic(int ch, int topic, String newName) {
  String path = "/ch" + String(ch) + "/index.txt";
  
  String allTopics[MAX_TOPICS];
  File f = SD.open(path);
  for(int i = 0; i < MAX_TOPICS; i++) {
    if(f.available()) allTopics[i] = f.readStringUntil('\n');
    else allTopics[i] = "Topic " + String(i+1);
    allTopics[i].trim();
  }
  f.close();
  
  allTopics[topic - 1] = newName;
  
  SD.remove(path);
  File wf = SD.open(path, FILE_WRITE);
  for(int i = 0; i < MAX_TOPICS; i++) {
    wf.println(allTopics[i]);
  }
  wf.close();
  
  if (currentMode == MODE_READER && currentFolder == ("ch" + String(ch))) {
    loadTopics(currentFolder);
  }
  
  return true;
}

