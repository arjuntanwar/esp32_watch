// ================= DEFAULT STRUCTURE =================
void createDefaultStructure() {
  showMessage("Creating files...", "", "");
  
  String defaultChapters[MAX_CHAPTERS] = {
    "Chapter 1",
    "Chapter 2", 
    "Chapter 3",
    "Chapter 4",
    "Chapter 5"
  };
  
  File index = SD.open("/index.txt", FILE_WRITE);
  for(int i = 0; i < MAX_CHAPTERS; i++) {
    index.println(defaultChapters[i]);
  }
  index.close();
  
  for(int ch = 1; ch <= MAX_CHAPTERS; ch++) {
    String folder = "/ch" + String(ch);
    SD.mkdir(folder);
    
    File topicIndex = SD.open(folder + "/index.txt", FILE_WRITE);
    for(int t = 1; t <= MAX_TOPICS; t++) {
      topicIndex.println("Topic " + String(t));
    }
    topicIndex.close();
    
    for(int t = 1; t <= MAX_TOPICS; t++) {
      File topic = SD.open(folder + "/topic" + String(t) + ".txt", FILE_WRITE);
      topic.println("Content for " + defaultChapters[ch-1] + " - Topic " + String(t));
      topic.println("\nEdit me via WiFi!");
      topic.close();
    }
  }
  delay(1000);
}

// ================= FILE LOADING =================
void loadChapters() {
  File f = SD.open("/index.txt");
  chapterCount = 0;
  if(!f) return;
  
  while(f.available() && chapterCount < MAX_CHAPTERS) {
    String line = f.readStringUntil('\n');
    line.trim();
    if(line.length() > 0) chapters[chapterCount++] = line;
  }
  f.close();
}

void loadTopics(String folder) {
  String path = "/" + folder + "/index.txt";
  File f = SD.open(path);
  topicCount = 0;
  if(!f) return;
  
  while(f.available() && topicCount < MAX_TOPICS) {
    String line = f.readStringUntil('\n');
    line.trim();
    if(line.length() > 0) topics[topicCount++] = line;
  }
  f.close();
}

void loadTopicContent(String folder, int topicIndex) {
  String path = "/" + folder + "/topic" + String(topicIndex + 1) + ".txt";
  File f = SD.open(path);
  lineCount = 0;
  
  if(!f) {
    textLines[lineCount++] = "File not found";
    return;
  }
  
  while(f.available() && lineCount < MAX_LINES) {
    String line = f.readStringUntil('\n');
    line.trim();
    
    while(line.length() > 21 && lineCount < MAX_LINES) {
      int wrap = 21;
      for(int i = 21; i > 15; i--) {
        if(i < line.length() && line.charAt(i) == ' ') {
          wrap = i;
          break;
        }
      }
      textLines[lineCount++] = line.substring(0, wrap);
      line = line.substring(wrap);
      line.trim();
    }
    
    if(line.length() > 0 && lineCount < MAX_LINES) {
      textLines[lineCount++] = line;
    }
  }
  f.close();
}

// ================= OTA SETUP =================
void setupOTA() {
  ArduinoOTA.setHostname("E-Reader");
  ArduinoOTA.setPassword("12345678");
  
  ArduinoOTA.onStart([]() {
    String type;
    if (ArduinoOTA.getCommand() == U_FLASH) {
      type = "sketch";
    } else {
      type = "filesystem";
    }
    Serial.println("Start updating " + type);
    display.clearDisplay();
    display.setCursor(10, 20);
    display.println("OTA Update");
    display.setCursor(10, 35);
    display.println("Updating...");
    display.display();
  });
  
  ArduinoOTA.onEnd([]() {
    Serial.println("\nEnd");
    display.clearDisplay();
    display.setCursor(10, 20);
    display.println("Update Complete!");
    display.setCursor(10, 35);
    display.println("Restarting...");
    display.display();
    delay(1000);
  });
  
  ArduinoOTA.onProgress([](unsigned int progress, unsigned int total) {
    int percent = (progress / (total / 100));
    Serial.printf("Progress: %u%%\r", percent);
    display.clearDisplay();
    display.setCursor(10, 20);
    display.println("OTA Progress");
    display.setCursor(10, 35);
    display.print(percent);
    display.println("%");
    display.display();
  });
  
  ArduinoOTA.onError([](ota_error_t error) {
    Serial.printf("Error[%u]: ", error);
    display.clearDisplay();
    display.setCursor(10, 20);
    display.println("OTA Error!");
    display.display();
    if (error == OTA_AUTH_ERROR) Serial.println("Auth Failed");
    else if (error == OTA_BEGIN_ERROR) Serial.println("Begin Failed");
    else if (error == OTA_CONNECT_ERROR) Serial.println("Connect Failed");
    else if (error == OTA_RECEIVE_ERROR) Serial.println("Receive Failed");
    else if (error == OTA_END_ERROR) Serial.println("End Failed");
  });
  
  ArduinoOTA.begin();
  Serial.println("OTA Ready");
}

