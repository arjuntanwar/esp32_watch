// ================= SD CARD INITIALIZATION =================
bool initSDCard() {
  SPI.begin(SD_SCK, SD_MISO, SD_MOSI, SD_CS);
  
  if (!SD.begin(SD_CS, SPI, 4000000)) {
    if (!SD.begin(SD_CS, SPI, 1000000)) {
      if (!SD.begin(SD_CS, SPI, 400000)) {
        return false;
      }
    }
  }
  return true;
}

