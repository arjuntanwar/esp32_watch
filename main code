// ================= BUTTON HANDLING =================
void handleButtons() {
  unsigned long now = millis();
  if(now - lastButtonTime < DEBOUNCE_DELAY) return;
  
  bool upPressed = (digitalRead(BTN_UP) == LOW);
  bool downPressed = (digitalRead(BTN_DOWN) == LOW);
  bool selectPressed = (digitalRead(BTN_SELECT) == LOW);
  bool backPressed = (digitalRead(BTN_BACK) == LOW);
  
  if (upPressed || downPressed || selectPressed || backPressed) {
    resetActivityTimer();
  }
  
  // ENTER READER MODE: SELECT + UP together (from watch mode)
  if(selectPressed && upPressed && !downPressed && !backPressed && !readerModeActive && currentMode == MODE_WATCH) {
    lastButtonTime = now;
    if(sdCardMounted) {
      enterReaderMode();
    } else {
      showPopup("No SD Card!", 1000);
    }
    return;
  }
  
  // EXIT TO WATCH MODE: SELECT + BACK together
  if(currentMode == MODE_READER && selectPressed && backPressed && !upPressed && !downPressed) {
    lastButtonTime = now;
    exitToWatchMode();
    return;
  }
  
  // MANUAL SLEEP: UP + BACK together
  if(currentMode == MODE_WATCH && upPressed && backPressed && !downPressed && !selectPressed) {
    lastButtonTime = now;
    goToDeepSleep();
    return;
  }
  
  // Handle navigation in different modes
  if(currentMode == MODE_WATCH) {
    // Only combo buttons work
  } 
  else if(currentMode == MODE_READER) {
    if(upPressed && !downPressed && !selectPressed && !backPressed) {
      lastButtonTime = now;
      switch(readerScreen) {
        case SCR_READER_MAIN:
          if(readerCursor > 0) readerCursor--;
          break;
        case SCR_READER_CHAPTERS:
          if(selectedChapter > 0) selectedChapter--;
          break;
        case SCR_READER_TOPICS:
          if(selectedTopic > 0) selectedTopic--;
          break;
        case SCR_READER_READ:
          if(scrollPosition > 0) scrollPosition--;
          break;
      }
      displayReaderMenu();
    }
    else if(downPressed && !upPressed && !selectPressed && !backPressed) {
      lastButtonTime = now;
      switch(readerScreen) {
        case SCR_READER_MAIN:
          if(readerCursor < 2) readerCursor++;
          break;
        case SCR_READER_CHAPTERS:
          if(selectedChapter < chapterCount - 1) selectedChapter++;
          break;
        case SCR_READER_TOPICS:
          if(selectedTopic < topicCount - 1) selectedTopic++;
          break;
        case SCR_READER_READ:
          if(scrollPosition + LINES_PER_SCREEN < lineCount) scrollPosition++;
          break;
      }
      displayReaderMenu();
    }
    else if(selectPressed && !upPressed && !downPressed && !backPressed) {
      lastButtonTime = now;
      if(readerScreen == SCR_READER_MAIN) {
        if(readerCursor == 0) {
          readerScreen = SCR_READER_CHAPTERS;
          selectedChapter = 0;
          displayReaderMenu();
        } else if(readerCursor == 1) {
          currentMode = MODE_AP;
          setupAPMode();
        } else if(readerCursor == 2) {
          exitToWatchMode();
        }
      } 
      else if(readerScreen == SCR_READER_CHAPTERS) {
        currentFolder = "ch" + String(selectedChapter + 1);
        currentChapterName = chapters[selectedChapter];
        loadTopics(currentFolder);
        readerScreen = SCR_READER_TOPICS;
        selectedTopic = 0;
        displayReaderMenu();
      } 
      else if(readerScreen == SCR_READER_TOPICS) {
        loadTopicContent(currentFolder, selectedTopic);
        readerScreen = SCR_READER_READ;
        scrollPosition = 0;
        displayReaderMenu();
      }
    }
    else if(backPressed && !upPressed && !downPressed && !selectPressed) {
      lastButtonTime = now;
      if(readerScreen == SCR_READER_MAIN) {
        exitToWatchMode();
      } else if(readerScreen == SCR_READER_CHAPTERS) {
        readerScreen = SCR_READER_MAIN;
        readerCursor = 0;
        displayReaderMenu();
      } else if(readerScreen == SCR_READER_TOPICS) {
        readerScreen = SCR_READER_CHAPTERS;
        selectedChapter = 0;
        displayReaderMenu();
      } else if(readerScreen == SCR_READER_READ) {
        readerScreen = SCR_READER_TOPICS;
        selectedTopic = 0;
        scrollPosition = 0;
        displayReaderMenu();
      }
    }
  }
  else if(currentMode == MODE_AP) {
    if(apEnabled) {
      handleWebRequests();
    }
    if(backPressed && !upPressed && !downPressed && !selectPressed) {
      lastButtonTime = now;
      stopAPMode();
      exitToWatchMode();
    }
  }
  else if(currentMode == MODE_SETTINGS) {
    if(upPressed && !downPressed && !selectPressed && !backPressed) {
      lastButtonTime = now;
      if(brightnessLevel < 100) brightnessLevel += 10;
      brightness = map(brightnessLevel, 0, 100, 0, 255);
      setBrightness(brightness);
      displaySettingsMain();
    }
    else if(downPressed && !upPressed && !selectPressed && !backPressed) {
      lastButtonTime = now;
      if(brightnessLevel > 0) brightnessLevel -= 10;
      brightness = map(brightnessLevel, 0, 100, 0, 255);
      setBrightness(brightness);
      displaySettingsMain();
    }
    else if(backPressed && !upPressed && !downPressed && !selectPressed) {
      lastButtonTime = now;
      exitToWatchMode();
    }
  }
}

// ================= DISPLAY FUNCTIONS =================
void displayReaderMenu() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  
  switch(readerScreen) {
    case SCR_READER_MAIN:
      {
        const char* items[] = {"Start Reading", "AP Mode (WiFi)", "Exit to Watch"};
        display.setCursor(0, 0);
        display.println("E-Reader");
        display.drawLine(0, 10, 128, 10, SSD1306_WHITE);
        for(int i = 0; i < 3; i++) {
          display.setCursor(0, 20 + i * 10);
          if(i == readerCursor) {
            display.print("> ");
            display.setTextColor(SSD1306_BLACK, SSD1306_WHITE);
            display.print(items[i]);
            display.setTextColor(SSD1306_WHITE);
          } else {
            display.print("  ");
            display.print(items[i]);
          }
        }
      }
      break;
      
    case SCR_READER_CHAPTERS:
      displayChapters();
      break;
      
    case SCR_READER_TOPICS:
      displayTopics();
      break;
      
    case SCR_READER_READ:
      displayText();
      break;
  }
  
  display.display();
}

void displayChapters() {
  display.setCursor(0, 0);
  display.println("Chapters");
  display.drawLine(0, 10, 128, 10, SSD1306_WHITE);
  
  if(selectedChapter < readerScrollTop) readerScrollTop = selectedChapter;
  if(selectedChapter >= readerScrollTop + VISIBLE_ITEMS) readerScrollTop = selectedChapter - VISIBLE_ITEMS + 1;
  
  for(int i = 0; i < VISIBLE_ITEMS; i++) {
    int idx = readerScrollTop + i;
    if(idx >= chapterCount) break;
    int y = 14 + i * 10;
    
    String txt = chapters[idx];
    if(txt.length() > 16) txt = txt.substring(0, 13) + "...";
    
    if(idx == selectedChapter) {
      display.fillRect(0, y-1, 128, 10, SSD1306_WHITE);
      display.setTextColor(SSD1306_BLACK);
      display.setCursor(2, y);
      display.print("> ");
      display.print(txt);
      display.setTextColor(SSD1306_WHITE);
    } else {
      display.setCursor(2, y);
      display.print("  ");
      display.print(txt);
    }
  }
  
  display.setCursor(0, 54);
  display.print(selectedChapter+1);
  display.print("/");
  display.print(chapterCount);
}

void displayTopics() {
  display.setCursor(0, 0);
  String title = currentChapterName;
  if(title.length() > 16) title = title.substring(0, 13) + "...";
  display.print(title);
  display.drawLine(0, 10, 128, 10, SSD1306_WHITE);
  
  if(selectedTopic < readerScrollTop) readerScrollTop = selectedTopic;
  if(selectedTopic >= readerScrollTop + VISIBLE_ITEMS) readerScrollTop = selectedTopic - VISIBLE_ITEMS + 1;
  
  for(int i = 0; i < VISIBLE_ITEMS; i++) {
    int idx = readerScrollTop + i;
    if(idx >= topicCount) break;
    int y = 14 + i * 10;
    
    String txt = topics[idx];
    if(txt.length() > 16) txt = txt.substring(0, 13) + "...";
    
    if(idx == selectedTopic) {
      display.fillRect(0, y-1, 128, 10, SSD1306_WHITE);
      display.setTextColor(SSD1306_BLACK);
      display.setCursor(2, y);
      display.print("> ");
      display.print(txt);
      display.setTextColor(SSD1306_WHITE);
    } else {
      display.setCursor(2, y);
      display.print("  ");
      display.print(txt);
    }
  }
  
  display.setCursor(0, 54);
  display.print(selectedTopic+1);
  display.print("/");
  display.print(topicCount);
}

void displayText() {
  int startLine = scrollPosition;
  if(startLine < 0) startLine = 0;
  if(startLine >= lineCount) startLine = lineCount - LINES_PER_SCREEN;
  if(startLine < 0) startLine = 0;
  
  for(int i = 0; i < LINES_PER_SCREEN; i++) {
    int lineIndex = startLine + i;
    if(lineIndex >= lineCount) break;
    
    display.setCursor(0, i * 8);
    String line = textLines[lineIndex];
    if(line.length() > 21) line = line.substring(0, 18) + "..";
    display.println(line);
  }
}

