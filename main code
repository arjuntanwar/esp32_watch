void displayWatchFace() {
  updateInternalRTC();
  
  display.clearDisplay();
  
  String timeStr;
  if(hours < 10) timeStr = "0" + String(hours);
  else timeStr = String(hours);
  timeStr += ":";
  if(minutes < 10) timeStr += "0" + String(minutes);
  else timeStr += String(minutes);
  
  String dateStr = getWeekDayString(weekDay) + " ";
  if(day < 10) dateStr += "0";
  dateStr += String(day) + "/";
  if(month < 10) dateStr += "0";
  dateStr += String(month);
  
  display.setTextSize(3);
  int16_t x1, y1;
  uint16_t w, h;
  display.getTextBounds(timeStr, 0, 0, &x1, &y1, &w, &h);
  int centerX_time = (SCREEN_WIDTH - w) / 2;
  int centerY_time = 20;
  display.setCursor(centerX_time, centerY_time);
  display.print(timeStr);
  
  display.setTextSize(1);
  display.getTextBounds(dateStr, 0, 0, &x1, &y1, &w, &h);
  int centerX_date = (SCREEN_WIDTH - w) / 2;
  int centerY_date = 52;
  display.setCursor(centerX_date, centerY_date);
  display.print(dateStr);
  
  display.display();
}

// ================= MAIN LOOP =================
void loop() {
  static unsigned long lastDisplay = 0;
  
  handleButtons();
  
  if (currentMode == MODE_WATCH) {
    if (millis() - lastActivityTime >= WATCH_SLEEP_TIMEOUT_MS) {
      goToDeepSleep();
    }
  }
  
  if(currentMode == MODE_WATCH) {
    if(millis() - lastDisplay > 100) {
      displayWatchFace();
      lastDisplay = millis();
    }
  } 
  else if(currentMode == MODE_READER) {
    if(millis() - lastDisplay > 100) {
      displayReaderMenu();
      lastDisplay = millis();
    }
  }
  else if(currentMode == MODE_AP) {
    if(millis() - lastDisplay > 100) {
      displayAPMain();
      lastDisplay = millis();
    }
    if(apEnabled) {
      server.handleClient();
      ArduinoOTA.handle();
    }
  }
  else if(currentMode == MODE_SETTINGS) {
    if(millis() - lastDisplay > 100) {
      displaySettingsMain();
      lastDisplay = millis();
    }
  }
  
  delay(10);
}

