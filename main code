// ================= READING PROGRESS =================
void saveReadingProgress() {
  rtc_lastChapter = selectedChapter;
  rtc_lastTopic = selectedTopic;
  rtc_lastScrollPos = scrollPosition;
  rtc_hasResumeData = true;
}

void loadReadingProgress() {
  if (rtc_hasResumeData) {
    selectedChapter = rtc_lastChapter;
    selectedTopic = rtc_lastTopic;
    scrollPosition = rtc_lastScrollPos;
  }
}

void enterReaderMode() {
  if(!sdCardMounted){
    showPopup("No SD Card!", 1500);
    return;
  }
  
  readerModeActive = true;
  currentMode = MODE_READER;
  resetActivityTimer();
  
  if (rtc_hasResumeData && rtc_lastChapter < chapterCount && rtc_lastTopic < 10) {
    selectedChapter = rtc_lastChapter;
    currentFolder = "ch" + String(selectedChapter + 1);
    currentChapterName = chapters[selectedChapter];
    loadTopics(currentFolder);
    
    selectedTopic = rtc_lastTopic;
    loadTopicContent(currentFolder, selectedTopic);
    scrollPosition = rtc_lastScrollPos;
    
    readerScreen = SCR_READER_READ;
    showPopup("Resuming Reading", 1000);
  } else {
    readerScreen = SCR_READER_MAIN;
    readerCursor = 0;
    selectedChapter = 0;
    selectedTopic = 0;
    scrollPosition = 0;
    showPopup("Entering Reader", 1000);
  }
  displayReaderMenu();
}

void exitToWatchMode() {
  if (currentMode == MODE_READER && readerScreen == SCR_READER_READ) {
    saveReadingProgress();
  }
  currentMode = MODE_WATCH;
  readerModeActive = false;
  readerScreen = SCR_READER_MAIN;
  readerCursor = 0;
  selectedChapter = 0;
  selectedTopic = 0;
  scrollPosition = 0;
  if(apEnabled) stopAPMode();
  resetActivityTimer();
  displayWatchFace();
}

// ================= SETUP =================
void setup() {
  Serial.begin(115200);
  rtc_bootCount++;
  Serial.println("Boot #" + String(rtc_bootCount));
  
  pinMode(BTN_UP, INPUT_PULLUP);
  pinMode(BTN_DOWN, INPUT_PULLUP);
  pinMode(BTN_SELECT, INPUT_PULLUP);
  pinMode(BTN_BACK, INPUT_PULLUP);
  
  oledPowerOn();
  loadRTC();
  
  // Show boot screen
  display.clearDisplay();
  display.setCursor(20, 20);
  display.println("Initializing...");
  display.display();
  delay(500);
  
  // Initialize SD card
  display.clearDisplay();
  display.setCursor(20, 20);
  display.println("SD Card...");
  display.display();
  
  sdCardMounted = initSDCard();
  
  if (sdCardMounted) {
    display.clearDisplay();
    display.setCursor(20, 20);
    display.println("SD Ready!");
    display.display();
    delay(500);
    
    if(!SD.exists("/index.txt")) {
      createDefaultStructure();
    }
    loadChapters();
  } else {
    display.clearDisplay();
    display.setCursor(15, 20);
    display.println("No SD Card!");
    display.setCursor(15, 35);
    display.println("Watch Only");
    display.display();
    delay(1500);
  }
  
  // Time sync
  if (!rtc_timeInitialized || rtc_bootCount == 1) {
    connectWiFiAndSync();
  } else {
    hours = rtc_hours;
    minutes = rtc_minutes;
    seconds = rtc_seconds;
    day = rtc_day;
    month = rtc_month;
    year = rtc_year;
    weekDay = rtc_weekDay;
    timeSynced = true;
  }
  
  setBrightness(brightness);
  resetActivityTimer();
  displayWatchFace();
  firstBoot = false;
}

// ================= RTC FUNCTIONS =================
void loadRTC() {
  if (rtc_timeInitialized) {
    hours = rtc_hours;
    minutes = rtc_minutes;
    seconds = rtc_seconds;
    day = rtc_day;
    month = rtc_month;
    year = rtc_year;
    weekDay = rtc_weekDay;
  }
}

void saveRTC() {
  rtc_hours = hours;
  rtc_minutes = minutes;
  rtc_seconds = seconds;
  rtc_day = day;
  rtc_month = month;
  rtc_year = year;
  rtc_weekDay = weekDay;
  rtc_timeInitialized = true;
}

void updateInternalRTC() {
  static unsigned long lastUpdate = 0;
  if (millis() - lastUpdate >= 1000) {
    seconds++;
    if (seconds >= 60) {
      seconds = 0;
      minutes++;
      if (minutes >= 60) {
        minutes = 0;
        hours++;
        if (hours >= 24) {
          hours = 0;
          day++;
          weekDay = (weekDay + 1) % 7;
          if (day > 31) {
            day = 1;
            month++;
            if (month > 12) {
              month = 1;
              year++;
            }
          }
        }
      }
    }
    lastUpdate = millis();
    saveRTC();
  }
}

// ================= DEEP SLEEP =================
void goToDeepSleep() {
  Serial.println("Going to deep sleep...");
  
  if (currentMode == MODE_READER && readerScreen == SCR_READER_READ) {
    saveReadingProgress();
  }
  saveRTC();
  oledPowerOff();
  
  esp_sleep_enable_ext0_wakeup((gpio_num_t)BTN_SELECT, 0);
  
  Serial.println("Sleeping... Wake on SELECT button");
  esp_deep_sleep_start();
}

// ================= TIME FUNCTIONS =================
void connectWiFiAndSync() {
  display.clearDisplay();
  display.setCursor(10, 20);
  display.println("Connecting to");
  display.setCursor(10, 35);
  display.println("FPV_CAM...");
  display.display();
  
  WiFi.mode(WIFI_STA);
  WiFi.begin(wifi_ssid, wifi_password);
  
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 30) {
    delay(500);
    attempts++;
  }
  
  if (WiFi.status() == WL_CONNECTED) {
    display.clearDisplay();
    display.setCursor(10, 20);
    display.println("Syncing Time...");
    display.display();
    
    syncTimeWithNTP();
    
    if (timeSynced) {
      display.clearDisplay();
      display.setCursor(25, 28);
      display.println("Time Set!");
      display.display();
      delay(1000);
    } else {
      display.clearDisplay();
      display.setCursor(20, 28);
      display.println("Sync Failed");
      display.display();
      delay(1000);
    }
    WiFi.disconnect(true);
    WiFi.mode(WIFI_OFF);
  } else {
    display.clearDisplay();
    display.setCursor(20, 28);
    display.println("No WiFi");
    display.display();
    delay(1500);
  }
}

void syncTimeWithNTP() {
  configTime(gmtOffset_sec, daylightOffset_sec, ntpServer);
  
  struct tm timeinfo;
  int attempts = 0;
  
  while (!getLocalTime(&timeinfo) && attempts < 10) {
    delay(500);
    attempts++;
  }
  
  if (attempts < 10) {
    hours = timeinfo.tm_hour;
    minutes = timeinfo.tm_min;
    seconds = timeinfo.tm_sec;
    day = timeinfo.tm_mday;
    month = timeinfo.tm_mon + 1;
    year = timeinfo.tm_year + 1900;
    weekDay = timeinfo.tm_wday;
    timeSynced = true;
    saveRTC();
  } else {
    timeSynced = false;
  }
}

String getWeekDayString(int wd) {
  switch(wd) {
    case 0: return "SUN";
    case 1: return "MON";
    case 2: return "TUE";
    case 3: return "WED";
    case 4: return "THU";
    case 5: return "FRI";
    case 6: return "SAT";
    default: return "MON";
  }
}

